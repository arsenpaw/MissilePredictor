// Every setting the app reads, with its default. Copy what you need into appsettings.Development.json
// or appsettings.Production.json (both gitignored), or set them as env vars (Section__Key, e.g. TelegramAi__Enabled).
// This file itself is never loaded.
{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "WTelegram": "Warning",
        "Hangfire": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext} {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  },

  // Master switch for the Telegram scraper, ML model, Google Sheets and the nightly
  // sync-telegram / model-training / restart-app jobs. false = Neptun-only.
  "TelegramAi": {
    "Enabled": true
  },

  // Used only when TelegramAi:Enabled is true.
  "Telegram": {
    "Mock": false,                        // true = MockTgScraperService, no Telegram login
    "ApiId": 0,                           // from https://my.telegram.org
    "ApiHash": "",
    "Channel": "rocket_danger_lviv",
    "SessionPath": "data/tg.session",
    "PhoneNumber": "+380000000000",       // first login only
    "VerificationCode": null,             // first login only
    "Password": null                      // 2FA password, if set
  },

  // Used only when TelegramAi:Enabled is true.
  "ML": {
    "ModelPath": "data/sentiment.zip"
  },

  // Used only when TelegramAi:Enabled is true.
  "Google": {
    "CredentialsFilePath": "data/credentials.json",   // service account key
    "SpreadsheetId": "",
    "Range": "train!A1:D"
  },

  "Neptun": {
    "StreamUrl": "wss://neptun.in.ua/api/v1/stream",
    "Areas": [
      // From = genitive form for alert text ("км від Львову"); defaults to Title.
      { "Title": "Львів", "From": "Львову", "Latitude": 49.8397, "Longitude": 24.0297, "RadiusKm": 10 }
    ]
  },

  "History": {
    "ConnectionString": "Data Source=data/history.db",
    "UnalertedTrackRetention": "06:00:00"     // hh:mm:ss; tracks that never alerted are purged after this
  },

  "HomeAssistant": {
    "Mock": false,                        // true = alerts go to the console, the real alarm never fires
    "BaseUrl": "https://example.com",
    "Token": "",                          // long-lived access token
    "WebhookId": "missile_predictor_alert",
    "AccessClientId": null,               // Cloudflare Access service token, if HA is behind Zero Trust
    "AccessClientSecret": null
  }
}
