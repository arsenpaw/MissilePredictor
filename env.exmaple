# Host port the API is published on (container always listens on 8080).
PORT=8080

# Set to false to run Neptun-only: no Telegram scraper, ML model, Google Sheets or nightly jobs.
TELEGRAM_AI_ENABLED=true

# Telegram — https://my.telegram.org
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_CHANNEL=
TELEGRAM_PHONE=

# Google Sheets — the service account JSON goes in the data volume as credentials.json
GOOGLE_SPREADSHEET_ID=
GOOGLE_RANGE=

# Home Assistant.
# Must be reachable FROM INSIDE THE CONTAINER: use an IP or a public hostname,
# never homeassistant.local — containers cannot resolve mDNS.
HOMEASSISTANT_BASEURL=
HOMEASSISTANT_TOKEN=
HOMEASSISTANT_WEBHOOKID=missile_predictor_alert

# Optional — only when Home Assistant is behind a Cloudflare Zero Trust application.
# Create under Zero Trust > Access > Service Auth, and add a Service Auth policy
# to the Access application that includes this token. Leave blank if unused.
HOMEASSISTANT_CF_CLIENT_ID=
HOMEASSISTANT_CF_CLIENT_SECRET=
